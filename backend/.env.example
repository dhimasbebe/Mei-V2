APP_NAME="Mei-V2 API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# DATABASE
# ---------------------------------------------------------------------------
# Default: SQLite (nol konfigurasi — file dibuat otomatis oleh setup script).
# Untuk memakai MySQL/MariaDB (seperti aplikasi lama), ganti 3 baris di bawah:
#
#   DB_CONNECTION=mysql
#   DB_HOST=127.0.0.1
#   DB_PORT=3306
#   DB_DATABASE=meiv2
#   DB_USERNAME=root
#   DB_PASSWORD=
#
DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/ke/database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Tidak butuh tabel cache/jobs -> pakai driver file & sync
CACHE_STORE=file
QUEUE_CONNECTION=sync

# ---------------------------------------------------------------------------
# SANCTUM (Bearer token untuk Flutter)
# ---------------------------------------------------------------------------
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1,localhost:8080,127.0.0.1:8080
# null = token tidak kedaluwarsa
SANCTUM_TOKEN_EXPIRATION=

MAIL_MAILER=log
